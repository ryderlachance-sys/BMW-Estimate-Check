# Database and app
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bmw_estimate_check?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""
ADMIN_PASSWORD=""

# Optional AI estimate parsing. Leave empty for local OCR/keyword parsing.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
AI_PARSING_ENABLED="true"
AI_PER_USER_DAILY_LIMIT="5"
AI_DAILY_CALL_LIMIT="40"
AI_MONTHLY_CALL_LIMIT="500"

# Affiliate tracking
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=""
NEXT_PUBLIC_EBAY_CAMPAIGN_ID=""
NEXT_PUBLIC_FCP_EURO_CLICK_ID=""

# eBay Browse API (server-side only). Enables automatic exact product,
# current price, and vehicle compatibility matching after customer review.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
